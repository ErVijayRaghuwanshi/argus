# ==============================================================================
# Project Argus: Local Sandbox Environment Configurations (Template)
# Copy this file to '.env' before running docker compose:
# cp .env.example .env
# ==============================================================================

# 1. Apache Kafka Settings
KAFKA_CLUSTER_ID=4L62xNx2Tda6nvSI7mD5dA
KAFKA_LOG_RETENTION_HOURS=24
KAFKA_TOPIC_RETENTION_MS=86400000

# 2. Redis Cache Settings
REDIS_PORT=6379

# 3. Apache NiFi Ingest Credentials
# Username must be at least 4 characters, Password at least 12 characters.
NIFI_ADMIN_USER=admin
NIFI_ADMIN_PASSWORD=argus-nifi-password-1234
NIFI_SENSITIVE_PROPS_KEY=argus-nifi-sensitive-props-key-123
NIFI_REGISTRY_PORT=18082

# JVM Heap Allocations
NIFI_HEAP_INIT=512m
NIFI_HEAP_MAX=1g

# 4. Neo4j Graph Database Credentials
# Format inside Compose: neo4j/YOUR_PASSWORD
NEO4J_PASSWORD=argus-local-dev-password

# 5. Apache Solr Settings
SOLR_PORT=8983

# 6. SignalForge Synthetic Stream Settings
# Speed: 60.0 means 1 simulated hour of activity is paced and generated every 1 minute of wall time.
# Boost it to 300.0 or 600.0 to test high-scale ingestion, or drop to 1.0 for real-time.
SIGNALFORGE_STREAM_SPEED=60.0
SIGNALFORGE_USERS_POOL=100
SIGNALFORGE_TOWERS_POOL=15

# 7. Complete Host Port Configurations
NIFI_PORT=8443
KAFKA_PORT=9092
KAFKA_UI_PORT=8080
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8085
SPARK_WORKER_WEBUI_PORT=8086
SPARK_HISTORY_WEBUI_PORT=18088
